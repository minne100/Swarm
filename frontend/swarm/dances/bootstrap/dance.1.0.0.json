{
  "name": "BootstrapDance",
  "version": "1.0.0",
  "description": "初始渲染界面",
  "bees": [
    { "name": "FetchProjectsBee", "version": "1.0.0", "alias": "fetch-projects" },
    { "name": "RenderProjectListBee", "version": "1.0.0", "alias": "render-project-list" },
    { "name": "RenderMessagesBee", "version": "1.0.0", "alias": "render-messages" },
    { "name": "RenderAttachmentsBee", "version": "1.0.0", "alias": "render-attachments" }
  ],
  "dances": [],
  "steps": [
    { "id": "fetch-projects", "alias": "fetch-projects", "description": "从后端获取项目列表", "onSuccess": "render-project-list", "onFail": "render-project-list" },
    { "id": "render-project-list", "alias": "render-project-list", "description": "渲染项目", "onSuccess": "render-messages", "onFail": "render-messages" },
    { "id": "render-messages", "alias": "render-messages", "description": "渲染消息", "onSuccess": "render-attachments", "onFail": "render-attachments" },
    { "id": "render-attachments", "alias": "render-attachments", "description": "渲染附件" }
  ]
}
